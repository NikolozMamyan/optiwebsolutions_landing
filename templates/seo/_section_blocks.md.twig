{% autoescape false %}
{% set section_key = entry.key ~ '.section.' ~ id %}
{% for block in section.blocks %}
{% if block.type == 'paragraph' %}
{% include 'seo/_paragraph.md.twig' with {'paragraph_key': section_key ~ '.p' ~ block.index, 'link_id': block.link|default(null)} %}

{% elseif block.type == 'list' %}
{% for bullet in block.start..block.end %}
{{ block.ordered|default(false) ? loop.index ~ '.' : '-' }} {{ (section_key ~ '.b' ~ bullet)|trans({}, 'messages', document_locale) }}
{% endfor %}

{% elseif block.type == 'table' %}
{% for column in 1..block.columns %}| {{ (section_key ~ '.table.h' ~ column)|trans({}, 'messages', document_locale) }} {% endfor %}|
{% for column in 1..block.columns %}| --- {% endfor %}|
{% for row in 1..block.rows %}
{% for column in 1..block.columns %}| {{ (section_key ~ '.table.r' ~ row ~ '.c' ~ column)|trans({}, 'messages', document_locale) }} {% endfor %}|
{% endfor %}

{% endif %}
{% endfor %}
{% endautoescape %}
