<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
    <channel>
        <title>{{ site_name }} — {{ 'editorial.journal'|trans }}</title>
        <link>{{ site_url|trim('/') }}{{ path('app_blog') }}</link>
        <description>{{ 'editorial.index.description'|trans }}</description>
        <language>{{ app.request.locale }}</language>
        <atom:link href="{{ site_url|trim('/') }}{{ path('app_blog_feed') }}" rel="self" type="application/rss+xml" />
{% for article in articles %}
        <item>
            <title>{{ (article.key ~ '.title')|trans }}</title>
            <link>{{ site_url|trim('/') }}{{ path('app_blog_article', {'slug': article.slugs[app.request.locale]}) }}</link>
            <guid isPermaLink="true">{{ site_url|trim('/') }}{{ path('app_blog_article', {'slug': article.slugs[app.request.locale]}) }}</guid>
            <description>{{ (article.key ~ '.excerpt')|trans }}</description>
            <pubDate>{{ article.published|date('r', 'Europe/Paris') }}</pubDate>
        </item>
{% endfor %}
    </channel>
</rss>
