<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{% for page in pages %}
{% for locale, location in page.urls %}
    <url>
        <loc>{{ location }}</loc>
{% if page.modified is defined %}
        <lastmod>{{ page.modified }}</lastmod>
{% endif %}
{% if page.cover is defined %}
        <image:image><image:loc>{{ site_url|trim('/') }}{{ asset(page.cover) }}</image:loc></image:image>
{% endif %}
    </url>
{% endfor %}
{% endfor %}
</urlset>
