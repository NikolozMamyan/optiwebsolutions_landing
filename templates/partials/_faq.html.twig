{% import '_ui.html.twig' as ui %}
<section class="section container faq-section" id="faq" aria-labelledby="faq-title">
    <div class="section-heading reveal"><p class="eyebrow">{{ faq_intro }}</p><h2 id="faq-title">{{ faq_heading }}<br><em>{{ faq_emphasis }}</em></h2></div>
    <div class="faq-list reveal" data-controller="faq">
        {% for faq in faqs %}
            <details class="faq-item" data-faq-target="item" data-action="toggle->faq#toggle"><summary>{{ faq.question }}<span class="faq-plus" aria-hidden="true"></span></summary><p>{{ faq.answer }}</p></details>
        {% endfor %}
    </div>
    <p class="faq-contact">{{ 'Une autre question ?'|trans }} <a href="mailto:{{ contact_email }}">{{ 'Écrivez-nous'|trans }} {{ ui.icon('arrow-up-right') }}</a></p>
</section>
{% set faq_entities = [] %}
{% for faq in faqs %}
    {% set faq_entities = faq_entities|merge([{
        '@type': 'Question',
        'name': faq.question,
        'acceptedAnswer': { '@type': 'Answer', 'text': faq.answer }
    }]) %}
{% endfor %}
<script type="application/ld+json">{{ {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faq_entities
}|json_encode(15)|raw }}</script>
