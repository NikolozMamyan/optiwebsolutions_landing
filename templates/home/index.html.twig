{% extends 'layout.html.twig' %}
{% block structured_data %}
<script type="application/ld+json">{{ {
    '@context': 'https://schema.org', '@graph': [
        {'@type': 'Service', '@id': canonical_url ~ '#website-service', 'name': 'Site web'|trans, 'description': 'Une vitrine soignée, rapide et pensée pour transformer vos visiteurs en contacts. Votre image, jusque dans le moindre détail.'|trans, 'provider': {'@id': site_origin ~ '/#organization'}, 'url': canonical_url ~ '#expertises'},
        {'@type': 'Service', '@id': canonical_url ~ '#application-service', 'name': 'Développement Symfony sur mesure'|trans, 'description': 'Un espace client, un outil métier, une plateforme SaaS. Une solution qui s’adapte à vos processus et accompagne votre activité.'|trans, 'provider': {'@id': site_origin ~ '/#organization'}, 'url': canonical_url ~ '#expertises'},
        {'@type': 'Service', '@id': canonical_url ~ '#it-service', 'name': 'Infogérance'|trans, 'description': 'Gardez le cap sur votre métier. Nous vous accompagnons dans le suivi, la maintenance et la gestion de votre environnement informatique.'|trans, 'provider': {'@id': site_origin ~ '/#organization'}, 'url': canonical_url ~ '#expertises'}
    ]
}|json_encode(15)|raw }}</script>
{% endblock %}
{% import '_ui.html.twig' as ui %}
{% set whatsapp_url = 'https://wa.me/' ~ whatsapp_number ~ '?text=' ~ ('Bonjour OptiWebSolutions, j’aimerais discuter de mon projet avec vous.'|trans|url_encode) %}
{% set tools = [
    { name: 'Symfony', icon: 'symfony', color: '#202223' },
    { name: 'PHP', icon: 'php', color: '#777bb3' },
    { name: 'JavaScript', icon: 'javascript', color: '#e1b716' },
    { name: 'React', icon: 'react', color: '#18a9c7' },
    { name: 'PostgreSQL', icon: 'postgresql', color: '#416e91' },
    { name: 'Docker', icon: 'docker', color: '#2496ed' },
    { name: 'GitHub', icon: 'github', color: '#202223' },
    { name: 'Figma', icon: 'figma', color: '#a259ff' }
] %}

{% block content %}
    <main id="contenu">
        <section class="hero container" id="accueil" aria-labelledby="hero-title">
            <p class="eyebrow hero-eyebrow">{{ 'Votre partenaire digital'|trans }}</p>
            <h1 id="hero-title">{{ 'Le digital qui fait'|trans }}<br><em>{{ 'avancer votre entreprise.'|trans }}</em></h1>
            <p class="hero-description">{{ 'Un site qui vous ressemble. Des outils qui vous simplifient la vie.'|trans }}<br class="desktop-break"> {{ 'Une informatique sur laquelle vous pouvez compter.'|trans }}</p>
            <div class="hero-actions">
                <a class="button button-dark" href="{{ path('app_contact') }}">{{ 'Parlons de votre projet'|trans }} <span class="button-arrow">{{ ui.icon('arrow-up-right') }}</span></a>
                <a class="text-link" href="#approche">{{ 'Découvrir notre approche'|trans }} {{ ui.icon('arrow-down') }}</a>
            </div>
            <div class="hero-reassurance"><span class="mini-brand" aria-hidden="true"><svg class="brand-symbol" focusable="false"><use href="{{ asset('brand-symbol.svg') }}#mark"></use></svg></span><p><strong>{{ 'Une idée. Un interlocuteur. Un projet qui avance.'|trans }}</strong><br>{{ 'À vos côtés, de la première discussion au suivi quotidien.'|trans }}</p></div>
            <ul class="hero-promises" aria-label="{{ 'Nos domaines d’intervention'|trans }}">
                <li>{{ 'Sites web sur mesure'|trans }}</li><li>{{ 'Applications & SaaS'|trans }}</li><li>{{ 'Infogérance'|trans }}</li><li>{{ 'Maintenance & évolution'|trans }}</li>
            </ul>
            <div class="tools-carousel" aria-label="{{ 'Les outils et technologies de vos projets'|trans }}" aria-roledescription="{{ 'carrousel'|trans }}" data-controller="tools" data-tools-pause-label-value="{{ 'Mettre le carrousel en pause'|trans }}" data-tools-play-label-value="{{ 'Relancer le carrousel'|trans }}">
                <div class="tools-track">
                    {% for copy in 1..2 %}
                        <div class="tools-group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
                            {% for tool in tools %}
                                <div class="tool" style="--tool-color: {{ tool.color }}; --tool-icon: url('{{ asset('icons/' ~ tool.icon ~ '.svg') }}')">
                                    <span class="tool-icon" aria-hidden="true"></span><span>{{ tool.name }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
                <button class="carousel-toggle" type="button" aria-label="{{ 'Mettre le carrousel en pause'|trans }}" aria-pressed="false" data-tools-target="toggle" data-action="tools#toggle"><span aria-hidden="true">Ⅱ</span></button>
            </div>
        </section>

        <section class="section container" id="approche" aria-labelledby="approche-title">
            <div class="section-heading reveal">
                <p class="eyebrow">{{ 'Simple, clair, ensemble'|trans }}</p>
                <h2 id="approche-title">{{ 'De votre idée au concret,'|trans }}<br><em>{{ 'sans les complications.'|trans }}</em></h2>
                <p>{{ 'Vous connaissez votre métier. Nous donnons vie à vos idées.'|trans }}</p>
            </div>
            <div class="steps-grid">
                {% for step in [
                    { title: 'Échange & cadrage'|trans, text: 'On parle de votre activité, de vos besoins et de vos objectifs. Ensemble, on définit un périmètre clair et les bonnes priorités.'|trans },
                    { title: 'Design & développement'|trans, text: 'On conçoit votre solution sur mesure, avec des points réguliers. Vous suivez l’avancement et vos retours font partie du projet.'|trans },
                    { title: 'Tests & mise en ligne'|trans, text: 'On vérifie les fonctionnalités, la performance et l’affichage sur mobile. Puis on met en ligne et on vous accompagne à la prise en main.'|trans },
                    { title: 'Suivi & évolution'|trans, text: 'Votre entreprise évolue, vos outils aussi. Maintenance, infogérance et nouvelles fonctionnalités : on garde le contact.'|trans }
                ] %}
                    <article class="step-card reveal">
                        <span class="step-number">0{{ loop.index }}</span>
                        <h3>{{ step.title }}</h3>
                        <p>{{ step.text }}</p>
                    </article>
                {% endfor %}
            </div>
            <div class="cta-strip reveal">
                <p>{{ 'Une idée en tête ?'|trans }} <strong>{{ 'On lui donne une suite.'|trans }}</strong></p>
                <div class="strip-actions"><a class="button button-dark" href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer">{{ 'On en discute'|trans }} <span class="button-arrow">{{ ui.icon('arrow-up-right') }}</span></a><a class="button button-outline" href="#solutions">{{ 'Voir les possibilités'|trans }} <span class="button-arrow">{{ ui.icon('arrow-up-right') }}</span></a></div>
            </div>
        </section>

        <section class="section container" id="expertises" aria-labelledby="expertises-title">
            <div class="section-heading reveal"><p class="eyebrow">{{ 'Trois expertises, un seul partenaire'|trans }}</p><h2 id="expertises-title">{{ 'Le bon outil.'|trans }}<br><em>{{ 'Pour le bon besoin.'|trans }}</em></h2></div>
            <div class="expertise-grid">
                <article class="expertise-card reveal">
                    <span class="service-icon service-icon-teal">{{ ui.icon('globe') }}</span>
                    <p class="card-kicker">{{ 'Votre présence en ligne'|trans }}</p>
                    <h3>{{ 'Des sites web'|trans }}<br>{{ 'qui font la différence.'|trans }}</h3>
                    <p>{{ 'Une vitrine soignée, rapide et pensée pour transformer vos visiteurs en contacts. Votre image, jusque dans le moindre détail.'|trans }}</p>
                    <ul class="check-list"><li>{{ 'Design adapté à votre identité'|trans }}</li><li>{{ 'Mobile, tablette et ordinateur'|trans }}</li><li>{{ 'Structure pensée pour le référencement'|trans }}</li></ul>
                    <a class="text-link" href="#offres">{{ 'Trouver l’inspiration'|trans }} {{ ui.icon('arrow-up-right') }}</a>
                </article>
                <article class="expertise-card reveal">
                    <span class="service-icon service-icon-purple">{{ ui.icon('code') }}</span>
                    <p class="card-kicker">{{ 'Vos idées, en application'|trans }}</p>
                    <h3>{{ 'Des applications'|trans }}<br>{{ 'qui vous ressemblent.'|trans }}</h3>
                    <p>{{ 'Un espace client, un outil métier, une plateforme SaaS. Une solution qui s’adapte à vos processus et accompagne votre activité.'|trans }}</p>
                    <ul class="check-list"><li>{{ 'Développement Symfony sur mesure'|trans }}</li><li>{{ 'Connexions à vos outils existants'|trans }}</li><li>{{ 'Une base conçue pour évoluer'|trans }}</li></ul>
                    <a class="text-link" href="#solutions">{{ 'Explorer les possibilités'|trans }} {{ ui.icon('arrow-up-right') }}</a>
                </article>
                <article class="expertise-card reveal">
                    <span class="service-icon service-icon-blue">{{ ui.icon('server') }}</span>
                    <p class="card-kicker">{{ 'Votre tranquillité au quotidien'|trans }}</p>
                    <h3>{{ 'Une informatique'|trans }}<br>{{ 'entre de bonnes mains.'|trans }}</h3>
                    <p>{{ 'Gardez le cap sur votre métier. Nous vous accompagnons dans le suivi, la maintenance et la gestion de votre environnement informatique.'|trans }}</p>
                    <ul class="check-list"><li>{{ 'Suivi de votre infrastructure'|trans }}</li><li>{{ 'Maintenance et mises à jour'|trans }}</li><li>{{ 'Un contact pour vos besoins techniques'|trans }}</li></ul>
                    <a class="text-link" href="#offres">{{ 'Parler infogérance'|trans }} {{ ui.icon('arrow-up-right') }}</a>
                </article>
            </div>
            <article class="ai-card reveal">
                <div class="ai-copy"><p class="eyebrow">{{ 'Moins de tâches, plus de valeur'|trans }}</p><h3>{{ 'L’IA, là où elle'|trans }}<br><em>{{ 'vous simplifie la vie.'|trans }}</em></h3><p>{{ 'Automatiser une tâche répétitive, faciliter la recherche d’informations ou connecter vos outils : on étudie ensemble ce qui peut vous faire gagner du temps, avec l’IA lorsque c’est pertinent.'|trans }}</p><div class="feature-tags"><span>{{ ui.icon('sparkles') }} {{ 'Assistants métier'|trans }}</span><span>{{ ui.icon('code') }} {{ 'Intégrations'|trans }}</span><span>{{ ui.icon('clock') }} {{ 'Automatisation'|trans }}</span></div></div>
                <div class="ai-visual" aria-hidden="true">
                    <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
                    <span class="orbit-node node-one">{{ ui.icon('mail') }}</span><span class="orbit-node node-two">{{ ui.icon('chart') }}</span><span class="orbit-node node-three">{{ ui.icon('code') }}</span>
                    <div class="ai-core">{{ ui.icon('sparkles') }}</div><span class="ai-caption"><span class="status-dot"></span> {{ 'Vos outils, connectés.'|trans }}</span>
                </div>
            </article>
        </section>

        {% set projects = [
            {
                id: 'consultants', name: 'Les-Consultants', headline: 'Former, simplement.'|trans,
                category: 'Plateforme e-learning'|trans, domain: 'elearning-lesconsultants.com',
                image: 'les-consultants-dashboard.webp', width: 1889, height: 887, tint: '#c6e8de', url: 'https://elearning-lesconsultants.com',
                description: 'Une plateforme de formation professionnelle qui réunit les cours, l’espace apprenant et le suivi des formations. Une expérience claire pour apprendre à son rythme et garder le fil de sa progression.'|trans,
                tags: ['E-learning'|trans, 'Espace apprenant'|trans, 'Suivi des formations'|trans]
            },
            {
                id: 'lnstrade', name: 'Lnstrade', headline: 'Une marque qui s’impose.'|trans,
                category: 'Site corporate'|trans, domain: 'lnstrade.fr/en',
                image: 'lnstrade.webp', tint: '#ffe197', url: 'https://lnstrade.fr/en/',
                description: 'Un site à l’identité affirmée pour présenter l’import, la distribution et l’univers de la marque ULTRAPOP. Des produits mis en scène, une navigation directe et un catalogue accessible en un clic.'|trans,
                tags: ['Identité de marque'|trans, 'International'|trans, 'Catalogue'|trans]
            },
            {
                id: 'ultrapop', name: 'ULTRAPOP', headline: 'Un univers. Une boutique.'|trans,
                category: 'E-commerce'|trans, domain: 'ultrapop.com',
                image: 'ultrapop.webp', tint: '#ffd5be', url: 'https://ultrapop.com',
                description: 'La pop culture prend vie dans une boutique en ligne pleine d’énergie. Des collections sous licence, un catalogue de produits et un parcours d’achat qui prolongent l’univers de la marque.'|trans,
                tags: ['Boutique en ligne'|trans, 'Catalogue produits'|trans, 'Pop culture'|trans]
            },
            {
                id: 'catalogue', name: 'Catalogue digital', headline: 'Vos produits prennent vie.'|trans,
                category: 'Solution sur mesure'|trans, domain: 'lnstrade.fr/catalogue',
                image: 'catalogue.webp', tint: '#c9def9', url: 'https://lnstrade.fr/catalogue',
                description: 'Un catalogue interactif à feuilleter, partager et explorer. Animation des pages, sommaire, zoom et téléchargement : votre offre devient une expérience, accessible depuis un simple lien.'|trans,
                tags: ['Feuilletage animé'|trans, 'PDF'|trans, 'Sur mesure'|trans]
            },
            {
                id: 'mykeynest', name: 'MYKEYNEST', headline: 'Vos accès, sous contrôle.'|trans,
                category: 'Application SaaS'|trans, domain: 'key-nest.com',
                image: 'mykeynest-blurred.webp', width: 1819, height: 865, tint: '#bcead9', url: 'https://key-nest.com',
                description: 'Une application pour regrouper les accès de l’entreprise et organiser leur partage entre collaborateurs. Permissions, gestion des mots de passe et extension navigateur : les équipes gardent leurs outils à portée de main.'|trans,
                tags: ['Gestion des accès'|trans, 'Partage sécurisé'|trans, 'Extension navigateur'|trans]
            }
        ] %}
        <section class="section portfolio-section" id="solutions" aria-labelledby="solutions-title" data-controller="projects" data-projects-announcement-label-value="{{ 'Projet %index% sur %total% : %name%'|trans }}">
            <div class="section-heading container reveal"><p class="eyebrow">{{ 'Des projets qui parlent pour nous'|trans }}</p><h2 id="solutions-title">{{ 'Des outils concrets.'|trans }}<br><em>{{ 'De nouvelles possibilités.'|trans }}</em></h2><p>{{ 'Cinq projets, cinq univers. Le même soin du détail.'|trans }}</p></div>
            <div class="project-tabs reveal" role="tablist" aria-label="{{ 'Nos réalisations'|trans }}">
                {% for project in projects %}
                    <button id="tab-{{ project.id }}" class="project-tab" type="button" role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}" aria-controls="panel-{{ project.id }}" tabindex="{{ loop.first ? '0' : '-1' }}" data-projects-target="tab" data-projects-index-param="{{ loop.index0 }}" data-action="click->projects#select keydown->projects#keydown"><span class="project-tab-number">0{{ loop.index }}</span>{{ project.name }}</button>
                {% endfor %}
            </div>
            <div class="container portfolio-carousel reveal" aria-roledescription="{{ 'carrousel'|trans }}" aria-label="{{ 'Nos projets clients'|trans }}" data-projects-target="carousel">
                <div class="project-slides">
                    {% for project in projects %}
                        <article class="project-panel" id="panel-{{ project.id }}" role="tabpanel" aria-labelledby="tab-{{ project.id }}" tabindex="0" data-projects-target="panel"{% if not loop.first %} hidden{% endif %}>
                            <div class="project-visual" style="--project-tint: {{ project.tint }}">
                                <span class="project-visual-label"><span class="status-dot"></span> {{ project.category }}</span>
                                <div class="project-browser">
                                    <div class="project-browser-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{{ project.domain }}</span>{{ ui.icon('globe') }}</div>
                                    <img src="{{ asset('projects/' ~ project.image) }}" srcset="{{ asset('projects/' ~ project.image|replace({'.webp': '-640.webp'})) }} 640w, {{ asset('projects/' ~ project.image) }} {{ project.width|default(1440) }}w" sizes="(max-width: 760px) 100vw, 50vw" alt="{{ 'Aperçu du projet'|trans }} {{ project.name }}" width="{{ project.width|default(1440) }}" height="{{ project.height|default(960) }}" loading="lazy" decoding="async">
                                </div>
                            </div>
                            <div class="project-copy">
                                <span class="project-category">{{ 'Projet client ·'|trans }} {{ project.category }}</span>
                                <h3>{{ project.name }}<br><em>{{ project.headline }}</em></h3>
                                <div class="project-tags">{% for tag in project.tags %}<span>{{ tag }}</span>{% endfor %}</div>
                                <p>{{ project.description }}</p>
                                <a class="button button-outline" href="{{ project.url }}" target="_blank" rel="noopener noreferrer">{{ 'Découvrir le projet'|trans }} <span class="button-arrow">{{ ui.icon('arrow-up-right') }}</span></a>
                                {% set project_case = cases|filter(case => case.id == project.id)|first %}
                                <a class="project-contact text-link" href="{{ path('app_case_study', {'slug': project_case.slugs[app.request.locale]}) }}">{{ 'editorial.case_read'|trans }} {{ ui.icon('arrow-right') }}</a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
                <div class="project-controls" aria-label="{{ 'Changer de projet'|trans }}">
                    <button class="project-step project-previous" type="button" aria-label="{{ 'Projet précédent'|trans }}" data-action="projects#previous">{{ ui.icon('chevron-down') }}</button>
                    <span class="project-count" aria-hidden="true"><strong data-projects-target="count">01</strong><span>/ {{ '%02d'|format(projects|length) }}</span></span>
                    <button class="project-step project-next" type="button" aria-label="{{ 'Projet suivant'|trans }}" data-action="projects#next">{{ ui.icon('chevron-down') }}</button>
                </div>
                <span class="sr-only project-announcement" role="status" aria-atomic="true" data-projects-target="announcement">{{ 'Projet %index% sur %total% : %name%'|trans({'%index%': 1, '%total%': projects|length, '%name%': projects[0].name}) }}</span>
            </div>
        </section>

        <section class="section container" aria-labelledby="engagements-title">
            <div class="section-heading reveal"><p class="eyebrow">{{ 'Une collaboration en confiance'|trans }}</p><h2 id="engagements-title">{{ 'Du code, du soin,'|trans }}<br><em>{{ 'et des engagements clairs.'|trans }}</em></h2></div>
            <div class="commitments-grid">
                <article class="commitment-card commitment-wide reveal"><span class="commitment-icon">{{ ui.icon('messages') }}</span><h3>{{ 'Vous savez où en est votre projet.'|trans }}</h3><p>{{ 'Des échanges réguliers, des explications compréhensibles et des décisions prises ensemble. Vous avez un interlocuteur, pas un numéro de ticket.'|trans }}</p><span class="card-footnote">{{ 'La communication, du début à la suite.'|trans }}</span></article>
                <article class="commitment-card commitment-accent reveal"><span class="card-kicker">{{ 'Notre façon de travailler'|trans }}</span><span class="big-word">{{ 'À vos'|trans }}<br><em>{{ 'côtés.'|trans }}</em></span><p>{{ 'Un partenariat qui ne s’arrête pas à la mise en ligne.'|trans }}</p></article>
                <article class="commitment-card reveal"><span class="commitment-icon">{{ ui.icon('code') }}</span><h3>{{ 'Votre projet.'|trans }}<br>{{ 'Votre code.'|trans }}</h3><p>{{ 'Pour un développement sur mesure, les livrables et les conditions de reprise sont définis dès le départ.'|trans }}</p></article>
                <article class="commitment-card commitment-wide reveal"><span class="commitment-icon">{{ ui.icon('shield') }}</span><h3>{{ 'Un cadre clair, avant de commencer.'|trans }}</h3><p>{{ 'Le périmètre, les étapes, le budget et le suivi sont convenus ensemble. Vous pouvez vous concentrer sur l’essentiel : votre activité.'|trans }}</p><span class="card-footnote">{{ 'Chaque projet commence par une bonne discussion.'|trans }}</span></article>
            </div>
        </section>

        <section class="section container agency-section" id="agence" aria-labelledby="agence-title">
            <div class="section-heading reveal"><p class="eyebrow">{{ 'Derrière vos outils, un partenaire'|trans }}</p><h2 id="agence-title">{{ 'La technique, oui.'|trans }}<br><em>{{ 'L’humain, toujours.'|trans }}</em></h2></div>
            <div class="agency-card reveal"><div class="agency-brand-panel"><span class="agency-decoration decoration-one"></span><span class="agency-decoration decoration-two"></span><div class="brand-lockup" role="img" aria-label="{{ site_name }}">{% include 'partials/_brand.html.twig' %}</div><span class="agency-brand-caption">{{ 'Vos idées. Notre savoir-faire.'|trans }}</span></div><div class="agency-copy"><span class="project-category">{{ site_name }}</span><h3>{{ 'Un partenaire impliqué'|trans }}<br>{{ 'dans votre quotidien.'|trans }}</h3><p>{{ 'Créer un outil utile commence par comprendre ceux qui l’utilisent. Nous prenons le temps d’écouter votre besoin pour construire une solution adaptée à votre entreprise.'|trans }}</p><p>{{ 'Du web à l’infogérance, notre approche reste la même : de la clarté, du concret et une relation directe.'|trans }}</p><p>{{ 'seo.home.location'|trans }}</p><a class="text-link" href="mailto:{{ contact_email }}">{{ 'Faisons connaissance'|trans }} {{ ui.icon('arrow-up-right') }}</a></div></div>
        </section>

        <section class="section container ideas-section" id="offres" aria-labelledby="offres-title">
            <div class="section-heading reveal"><p class="eyebrow">{{ 'Des pistes pour vous inspirer'|trans }}</p><h2 id="offres-title">{{ 'Une idée aujourd’hui.'|trans }}<br><em>{{ 'Votre projet demain.'|trans }}</em></h2><p>{{ 'Voici quelques idées pour faire avancer votre entreprise. On imagine la suite ensemble, autour de vos besoins.'|trans }}</p></div>
            <div class="pricing-grid">
                <article class="price-card reveal"><span class="card-kicker">{{ 'Présence en ligne'|trans }}</span><h3>{{ 'Site web'|trans }}</h3><p class="price-description">{{ 'Une présence qui vous ressemble et donne envie de découvrir votre entreprise.'|trans }}</p><ul class="check-list"><li>{{ 'Site vitrine d’entreprise'|trans }}</li><li>{{ 'Boutique en ligne'|trans }}</li><li>{{ 'Catalogue digital interactif'|trans }}</li><li>{{ 'Présentation de vos services'|trans }}</li><li>{{ 'Prise de rendez-vous en ligne'|trans }}</li><li>{{ 'Connexion à vos outils'|trans }}</li></ul><a class="button button-outline" href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer">{{ 'Imaginons votre site'|trans }} <span class="button-arrow">{{ ui.icon('arrow-up-right') }}</span></a></article>
                <article class="price-card price-card-featured reveal"><span class="recommended">{{ 'Pensé pour votre métier'|trans }}</span><span class="card-kicker">{{ 'Applications & plateformes'|trans }}</span><h3>{{ 'Webapp & SaaS'|trans }}</h3><p class="price-description">{{ 'Un outil sur mesure pour simplifier votre quotidien et donner vie à vos idées.'|trans }}</p><ul class="check-list"><li>{{ 'Espace client personnalisé'|trans }}</li><li>{{ 'Tableau de bord métier'|trans }}</li><li>{{ 'Plateforme e-learning'|trans }}</li><li>{{ 'Logiciel de gestion'|trans }}</li><li>{{ 'Automatisation de tâches'|trans }}</li><li>{{ 'Intégrations à vos outils'|trans }}</li></ul><a class="button button-dark" href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer">{{ 'Créons votre outil'|trans }} <span class="button-arrow">{{ ui.icon('arrow-up-right') }}</span></a></article>
                <article class="price-card reveal"><span class="card-kicker">{{ 'Sérénité au quotidien'|trans }}</span><h3>{{ 'Infogérance'|trans }}</h3><p class="price-description">{{ 'Des pistes pour rendre votre environnement informatique plus simple à gérer.'|trans }}</p><ul class="check-list"><li>{{ 'Organisation de votre hébergement'|trans }}</li><li>{{ 'Suivi de vos services'|trans }}</li><li>{{ 'Maintenance et mises à jour'|trans }}</li><li>{{ 'Accompagnement de votre équipe'|trans }}</li><li>{{ 'Conseil technique au quotidien'|trans }}</li><li>{{ 'Évolution de votre infrastructure'|trans }}</li></ul><a class="button button-outline" href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer">{{ 'Parlons de votre IT'|trans }} <span class="button-arrow">{{ ui.icon('arrow-up-right') }}</span></a></article>
            </div>
            <div class="pricing-reassurance"><span>{{ ui.icon('check') }} {{ 'Des idées comme point de départ'|trans }}</span><span>{{ ui.icon('check') }} {{ 'Un projet adapté à vos besoins'|trans }}</span><span>{{ ui.icon('check') }} {{ 'Un interlocuteur dédié'|trans }}</span></div>
        </section>

        {% include 'partials/_faq.html.twig' with {
            faq_intro: 'Création web, applications & infogérance'|trans,
            faq_heading: 'Vous avez des questions.'|trans,
            faq_emphasis: 'On a des réponses.'|trans,
            faqs: [
                { question: 'Quels projets web réalise OptiWebSolutions ?'|trans, answer: 'Nous accompagnons les entreprises dans la création de sites vitrines, de boutiques en ligne, de plateformes e-learning, de catalogues digitaux et d’applications métier. Chaque projet part de vos objectifs et des besoins de vos utilisateurs.'|trans },
                { question: 'Pourquoi créer une application web sur mesure avec Symfony ?'|trans, answer: 'Symfony permet de construire une application PHP structurée autour de vos besoins métier. Cette approche convient aux espaces clients, aux plateformes de formation, aux logiciels internes et aux projets qui nécessitent des fonctionnalités ou des intégrations spécifiques.'|trans },
                { question: 'Combien coûte un site web ou une application sur mesure ?'|trans, answer: 'Le prix dépend du périmètre, du design, des fonctionnalités et des intégrations nécessaires. Nous proposons un devis personnalisé après le cadrage. Le budget et les livrables sont convenus avant le démarrage.'|trans },
                { question: 'Combien de temps faut-il pour réaliser mon projet ?'|trans, answer: 'Le délai dépend de la taille du projet et des contenus disponibles. Après notre premier échange, nous établissons un calendrier avec des étapes de validation pour que vous puissiez suivre l’avancement.'|trans },
                { question: 'Mon site sera-t-il adapté aux mobiles et au référencement naturel ?'|trans, answer: 'Les interfaces sont conçues pour les smartphones, les tablettes et les ordinateurs. Nous travaillons aussi la structure des pages, leurs titres, leurs métadonnées et les performances techniques. Le référencement dépend ensuite également de la qualité de vos contenus et de la concurrence sur vos recherches cibles.'|trans },
                { question: 'Pouvez-vous créer un catalogue digital interactif ?'|trans, answer: 'Oui. Nous pouvons concevoir un catalogue adapté à vos produits : présentation interactive, feuilletage animé, navigation par catégories ou connexion à vos données. Les fonctionnalités et le mode de mise à jour sont définis avec vous pendant le cadrage.'|trans },
                { question: 'Pouvez-vous reprendre et maintenir un site existant ?'|trans, answer: 'Nous pouvons étudier votre site, votre application ou votre infrastructure actuelle. Une première analyse permet d’identifier les contraintes techniques et les améliorations à prévoir. Nous définissons ensuite les modalités de maintenance, de suivi et d’évolution.'|trans },
                { question: 'À quoi sert l’infogérance pour mon entreprise ?'|trans, answer: 'Elle permet de déléguer tout ou partie du suivi de votre environnement informatique. Le périmètre peut inclure la maintenance, les mises à jour, la supervision et l’accompagnement technique, selon ce qui est convenu dans votre offre.'|trans }
            ]
        } %}

        <section class="section container closing-cta reveal" aria-labelledby="closing-title">
            <p class="eyebrow">{{ 'À vous de jouer'|trans }}</p>
            <h2 id="closing-title">{{ 'Le prochain beau projet ?'|trans }}<br><em>{{ 'Le vôtre.'|trans }}</em></h2>
            <p>{{ 'Une idée, un besoin, une envie de faire mieux. Parlons-en.'|trans }}</p>
            <a class="button button-dark" href="{{ path('app_contact') }}">{{ 'Donnons vie à votre projet'|trans }} <span class="button-arrow">{{ ui.icon('arrow-up-right') }}</span></a>
        </section>
        <section class="section container home-journal" aria-labelledby="home-journal-title">
            <div class="editorial-section-heading reveal"><div><p class="eyebrow">{{ 'editorial.home.eyebrow'|trans }}</p><h2 id="home-journal-title">{{ 'editorial.home.heading'|trans }}<br><em>{{ 'editorial.home.emphasis'|trans }}</em></h2><p>{{ 'editorial.home.intro'|trans }}</p></div><a class="button button-outline" href="{{ path('app_blog') }}">{{ 'editorial.home.all'|trans }}<span class="button-arrow">{{ ui.icon('arrow-up-right') }}</span></a></div>
            <div class="journal-grid">{% for article in articles|slice(0, 2) %}{% include 'editorial/_article_card.html.twig' %}{% endfor %}</div>
        </section>
        {% include 'editorial/_cases_section.html.twig' %}
    </main>

