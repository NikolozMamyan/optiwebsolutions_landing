{% import '_ui.html.twig' as ui %}
{% if prospects is empty %}<div class="admin-empty">{{ ui.icon('messages') }}<h2>Les prochaines conversations commencent ici.</h2><p>Les demandes envoyées depuis le site apparaîtront dans cet espace.</p></div>{% else %}
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Prénom et nom</th><th>Coordonnées</th><th>Message</th><th>Reçu le</th><th>Copier</th></tr></thead><tbody>
{% for prospect in prospects %}
    <tr data-controller="copy"><td><strong>{{ prospect.firstName }} {{ prospect.lastName }}</strong><small>#{{ prospect.id }}</small></td><td><a href="mailto:{{ prospect.email }}">{{ prospect.email }}</a>{% if prospect.phone %}<a href="tel:{{ prospect.phone }}">{{ prospect.phone }}</a>{% else %}<small>Téléphone non renseigné</small>{% endif %}</td><td>{% if prospect.message %}<details class="prospect-message"><summary>{{ prospect.message|slice(0, 90) }}{{ prospect.message|length > 90 ? '…' : '' }}</summary><p>{{ prospect.message }}</p></details>{% else %}<span class="admin-muted">Aucun message</span>{% endif %}</td><td class="admin-date">{{ prospect.createdAt|date('d/m/Y', 'Europe/Paris') }}<small>{{ prospect.createdAt|date('H:i', 'Europe/Paris') }}</small></td><td><pre class="sr-only" data-copy-target="text">{{ 'Prénom : ' ~ prospect.firstName ~ "\nNom : " ~ prospect.lastName ~ "\nE-mail : " ~ prospect.email ~ "\nTéléphone : " ~ (prospect.phone ?? 'Non renseigné') ~ "\nMessage :\n    " ~ ((prospect.message ?? 'Non renseigné')|replace({"\n": "\n    "})) ~ "\nReçu le : " ~ prospect.createdAt|date('d/m/Y H:i', 'Europe/Paris') }}</pre><button class="admin-copy" type="button" data-action="copy#copy" aria-label="Copier les informations de {{ prospect.firstName }} {{ prospect.lastName }}">{{ ui.icon('code') }}<span data-copy-target="status" aria-live="polite">Copier</span></button></td></tr>
{% endfor %}
</tbody></table></div>
{% endif %}
